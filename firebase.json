{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "default",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "functions/**",
        "**/.*",
        "**/node_modules/**",
        "index - Copia.html"
      ]
    },
    {
      "target": "financaspro",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "functions/**",
        "**/.*",
        "**/node_modules/**",
        "index - Copia.html"
      ]
    }
  ]
}
