{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "default",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "functions/**",
        "**/.*",
        "**/node_modules/**",
        "index - Copia.html",
        "*.md",
        "deploy_log.txt",
        "docs/**",
        "js/**",
        "styles/**",
        "staging_pagina_links_utopia/**",
        "staging_site_pulso_utopia/**",
        "materiais_instagram/**",
        "assets/Design sem nome.png",
        "assets/hero-financaspro-para-canva.png",
        "assets/hero-financaspro-transparent.png",
        "assets/hero-financaspro-v3.png",
        "assets/hero-financaspro.png"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://financaspro.web.app/index.html",
          "type": 301
        },
        {
          "source": "/index.html",
          "destination": "https://financaspro.web.app/index.html",
          "type": 301
        },
        {
          "source": "/manifest.json",
          "destination": "https://financaspro.web.app/manifest.json",
          "type": 301
        }
      ]
    },
    {
      "target": "financaspro",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "functions/**",
        "**/.*",
        "**/node_modules/**",
        "index - Copia.html",
        "*.md",
        "deploy_log.txt",
        "docs/**",
        "js/**",
        "styles/**",
        "staging_pagina_links_utopia/**",
        "staging_site_pulso_utopia/**",
        "materiais_instagram/**",
        "assets/Design sem nome.png",
        "assets/hero-financaspro-para-canva.png",
        "assets/hero-financaspro-transparent.png",
        "assets/hero-financaspro-v3.png",
        "assets/hero-financaspro.png"
      ]
    }
  ]
}
